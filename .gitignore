# Python environments and package/build outputs
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Test, type-check, and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Editors and operating-system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local configuration and temporary files
.env
.env.*
!.env.example
*.tmp
*.temp
*.log

# Raw and processed datasets are never versioned
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Only explicitly approved sample fixtures may be committed
data/sample/*
!data/sample/.gitkeep
!data/sample/approved_demo.csv

# Generated models and other runtime artifacts are never versioned
artifacts/**
!artifacts/.gitkeep
